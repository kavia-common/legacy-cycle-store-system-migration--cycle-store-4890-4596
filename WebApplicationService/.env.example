# Public Web Application configuration
# IMPORTANT: The orchestrator will populate the real .env.
# Do not commit actual secrets here.

# Base URL for API Gateway Service (e.g., https://api.cyclestore.com or local gateway URL)
NEXT_PUBLIC_API_BASE_URL=https://api.cyclestore.com

# Optional Monitoring and Logging service endpoint for client-side analytics/error reporting
# If set, client errors will be sent via POST {timestamp, level, message, source, context}
NEXT_PUBLIC_MONITORING_URL=https://api.monitoring.example.com/v1

# Name and environment for the app (used in logs)
NEXT_PUBLIC_APP_NAME=Cycle Store Web
NEXT_PUBLIC_ENVIRONMENT=development
